# UGC Factory — environment template.
# Copy to `.env` (gitignored) and fill in your real key:
#   cp .env.example .env
# Format: KEY=VALUE. A `#` starts a full-line comment; ` //` starts an
# inline comment (URLs keep their `//`). Real environment variables always
# win over values set here.

# --- One OpenRouter key drives everything -------------------------------
# https://openrouter.ai/settings/keys
OPEN_ROUTER_API_KEY=sk-or-v1-your-key-here

# --- Jev: calibrated decisions (TypeSafe) via the Decisions API ---------
# Typed Choice questions in, probability distributions out.
OPEN_ROUTER_MODEL=typesafe/jev-1.14
OPEN_ROUTER_JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions

# --- LLM: reel typing / prompt generation (OpenAI-compatible endpoint) --
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Production (pick one — exactly one UGC_LLM_MODEL line active; notes go
# on their own line, since the parser only strips ` //` inline comments):
# Claude Opus 5.5 — 1M ctx, $4/$20 per 1M:
UGC_LLM_MODEL=anthropic/claude-opus-5.5
# GPT-6 Astra — 1.05M ctx, $10/$50 per 1M:
# UGC_LLM_MODEL=openai/gpt-6-astra

# Test baseline (free, deliberately weak — exercises fallbacks and honest
# status copy; NOT a production model):
# UGC_LLM_MODEL=stealth/crouton-alpha

# --- Advanced: override the derived engine variables directly -----------
# (unset → derived from the OpenRouter block above by bridge.py)
# JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# JEV_API_KEY=sk-or-v1-...
# JEV_MODEL=typesafe/jev-1.14
# JEV_BASE_URL=            # legacy TypeSafe System One endpoint
# UGC_LLM_API_KEY=sk-or-v1-...
# UGC_LLM_BASE_URL=https://openrouter.ai/api/v1
# UGC_LLM_MODEL=anthropic/claude-opus-5.5
# PYTHON=python            # interpreter the UI's /api/engine shells out to
